# Copy this file to .env. Never commit .env or real credentials.
# For a backend outside Compose: PADDLE_STRUCTURE_URL=http://<internal-worker>:8090
# Compose configures its private OCR worker automatically (no public port).
POSTGRES_DB=stock_brief
POSTGRES_USER=stock_brief
POSTGRES_PASSWORD=change-me-for-local-development
DATABASE_URL=postgresql+psycopg://stock_brief:change-me-for-local-development@postgres:5432/stock_brief
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001
FRONTEND_HOST_PORT=3000
BACKEND_HOST_PORT=8001
POSTGRES_HOST_PORT=5432
DB_POOL_RECYCLE_SECONDS=300
DATA_DIR=/data
MAX_UPLOAD_BYTES=52428800
OCR_MIN_NATIVE_TEXT_CHARS=80
OCR_DPI=300

EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024
GENERATION_PROVIDER=ollama
GENERATION_MODEL=gemma3:4b
GENERATION_TEMPERATURE=0
OLLAMA_GENERATION_TIMEOUT_SECONDS=600
# Request execution_mode selects the provider; environment/key presence is not consent.
ANALYSIS_EXTERNAL_ENABLED=0
ANALYSIS_OLLAMA_FALLBACK_ENABLED=0
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_ATTEMPTS=2
GEMINI_RETRY_BASE_DELAY_SECONDS=1
CORS_ORIGINS=http://localhost:3000

# Isolated persistent E2E PostgreSQL only; keep the real value in root .env.
E2E_PERSISTENT_DB_PASSWORD=
# Opt-in development only; the E2E launcher accepts --low-memory.
# STOCK_BRIEF_LOW_MEMORY=1
# NEXT_DIST_DIR=.next-e2e
